# ---------- App ----------
NODE_ENV=development
PORT=3000
# Public HTTPS URL of this service (ngrok/cloudflared locally). Used for LiqPay server_url
# and as the ElevenLabs webhook target: ${PUBLIC_BASE_URL}/webhooks/elevenlabs
PUBLIC_BASE_URL=https://your-tunnel.example.com

# Overridden by docker-compose for the app container
DATABASE_URL=postgresql://ringo:ringo@localhost:5432/ringo?schema=public
REDIS_URL=redis://localhost:6379

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to run admin commands
ADMIN_TELEGRAM_IDS=
# Set to false to run the HTTP/worker part without long polling (e.g. second replica)
BOT_POLLING=true

# ---------- ElevenLabs (ElevenAgents + Twilio) ----------
ELEVENLABS_API_KEY=
# Filled after `npm run agent:sync` creates the agent
ELEVENLABS_AGENT_ID=
# ID of the Twilio number imported in ElevenLabs → Phone Numbers
ELEVENLABS_PHONE_NUMBER_ID=
# Secret shown when you create the post-call webhook in ElevenLabs
ELEVENLABS_WEBHOOK_SECRET=
# Optional, used by `npm run agent:sync`
ELEVENLABS_VOICE_ID=
ELEVENLABS_LLM=claude-opus-5-5

# ---------- Moderation LLM (Anthropic) ----------
ANTHROPIC_API_KEY=
MODERATION_MODEL=claude-opus-5-5

# ---------- LiqPay ----------
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_SANDBOX=true

# ---------- Business rules ----------
# Price per call in kopecks (4900 = 49 UAH)
CALL_PRICE=4900
TOPUP_OPTIONS_UAH=100,200,500
# Hard cap: 180 s (3 min)
MAX_CALL_DURATION_SEC=180
CALLS_PER_NUMBER_PER_DAY=1
CALLS_PER_NUMBER_PER_WEEK=3
# Calls are placed only between these hours, Europe/Kyiv
CALL_WINDOW_START_HOUR=9
CALL_WINDOW_END_HOUR=21
